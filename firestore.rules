rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Read-only metadata collections
    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }
    match /squads/{squadId} {
      allow read: if true;
      allow write: if false;
    }

    // User profiles (owner-only read/write)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Campaigns (owner-only read/write)
    match /campaigns/{campaignId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if request.auth != null && 
        (resource == null || resource.data.ownerUid == request.auth.uid) &&
        (request.resource == null || request.resource.data.ownerUid == request.auth.uid);
    }

    // Leagues (owner-only read/write)
    match /leagues/{leagueId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if request.auth != null && 
        (resource == null || resource.data.ownerUid == request.auth.uid) &&
        (request.resource == null || request.resource.data.ownerUid == request.auth.uid);
    }

    // Matches (owner-only read/write)
    match /matches/{matchId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if request.auth != null && 
        (resource == null || resource.data.ownerUid == request.auth.uid) &&
        (request.resource == null || request.resource.data.ownerUid == request.auth.uid);
    }

    // Rooms (publicly readable, server-write-only)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if false;
    }

    // Leaderboard (publicly readable, server-write-only)
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false; // Cloud Functions run in admin mode and bypass this rule
    }
  }
}
